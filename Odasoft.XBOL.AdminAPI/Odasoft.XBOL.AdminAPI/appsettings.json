{
    "$schema": "./appsettings.schema.json",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Localization": {
        "SupportedCultures": [
            "es-MX",
            "en"
        ],
        "DefaultCulture": "es-MX"
    },
    "Identity": {
        "Password": {
            "RequireDigit": true,
            "RequiredLength": 8
        },
        "User": {
            "RequireUniqueEmail": true
        }
    },
    "FileUpload": {
        "MultipartBodyLengthLimit": 104857600,
        "AllowedExtensions": [
            ".pdf",
            ".docx",
            ".doc",
            ".png",
            ".jpeg",
            ".jpg",
            ".webp"
        ]
    }
}
