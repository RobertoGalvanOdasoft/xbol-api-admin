{
  "allOf": [
    {
      "$ref": "https://json.schemastore.org/appsettings.json"
    }
  ],
  "properties": {
    "TicketingClient": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "BaseAddress": {
          "type": "string",
          "description": "Base URL for the ticketing API"
        }
      },
      "description": "Ticketing API client settings"
    },
    "Localization": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "SupportedCultures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of supported culture codes (e.g. es-MX, en)"
        },
        "DefaultCulture": {
          "type": "string",
          "description": "Default culture code used when no Accept-Language header is provided"
        }
      },
      "description": "Request localization and culture settings"
    },
    "Identity": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "Password": {
          "type": "object",
          "properties": {
            "RequireDigit": {
              "type": "boolean",
              "description": "Whether passwords must contain at least one digit",
              "default": true
            },
            "RequiredLength": {
              "type": "integer",
              "description": "Minimum required password length",
              "default": 8
            }
          },
          "description": "Password policy settings"
        },
        "User": {
          "type": "object",
          "properties": {
            "RequireUniqueEmail": {
              "type": "boolean",
              "description": "Whether each user must have a unique email address",
              "default": true
            }
          },
          "description": "User account settings"
        }
      },
      "description": "ASP.NET Identity password and user policy"
    },
    "FileUpload": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "MultipartBodyLengthLimit": {
          "type": "integer",
          "description": "Maximum multipart body length in bytes (default: 100 MB)",
          "default": 104857600
        },
        "AllowedExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowed file extensions for uploads",
          "default": [
            ".pdf",
            ".docx",
            ".doc",
            ".png",
            ".jpeg",
            ".jpg",
            ".webp"
          ]
        }
      },
      "description": "File upload size and extension restrictions"
    }
  },
  "type": "object"
}