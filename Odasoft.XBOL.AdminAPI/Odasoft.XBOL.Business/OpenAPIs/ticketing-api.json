  "components": {
    "schemas": {
      "BookingRequest": {
        "required": [
          "clientContact",
          "eventId",
          "holdToken",
          "paymentInfoRequest",
          "seats"
        ],
        "type": "object",
        "properties": {
          "seats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "holdToken": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "ticketType": {
            "type": "string",
            "nullable": true
          },
          "clientContact": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EventClientContactRequest"
              }
            ]
          },
          "paymentInfoRequest": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PaymentInfoRequest"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "EventClientContactRequest": {
        "type": "object",
        "properties": {
          "countryPhoneISO": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "fullName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EventListItem": {
        "required": [
