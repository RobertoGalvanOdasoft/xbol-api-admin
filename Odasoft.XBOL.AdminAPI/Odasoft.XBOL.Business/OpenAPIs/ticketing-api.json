            "type": "string"
          },
          "venueMapId": {
            "type": "integer",
            "format": "int64"
          },
          "venueName": {
            "type": "string"
          },
          "externalEventKey": {
            "type": "string"
          },
          "availableSeats": {
            "type": "integer",
            "format": "int32"
          },
          "totalSeats": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "EventListItemPagedResponse": {
        "required": [
