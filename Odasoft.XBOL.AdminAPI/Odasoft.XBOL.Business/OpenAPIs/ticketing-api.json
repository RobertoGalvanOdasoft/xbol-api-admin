            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "cashAmount": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "dolarAmount": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "creditAmount": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "otherAmount": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          }
        },
        "additionalProperties": false
