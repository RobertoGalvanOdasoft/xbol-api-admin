<!-- WalletCTA : BEGIN -->
<tr>
    <td style="padding: 0 40px 32px; text-align: center; background-color: {{ theme.surface }};">
        <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: auto;">
            <tr>
                <td style="text-align: center;">
                    <a href="{{ googleWalletUrl }}" target="_blank" style="display: inline-block;">
                        <img
                            src="cid:google-wallet"
                            width="200"
                            height="48"
                            alt="{{ 'Wallet_GoogleAlt' | t }}"
                            border="0"
                            style="height: auto; max-width: 200px; display: block;"
                        >
                    </a>
                </td>
            </tr>
            <tr>
                <td style="padding: 10px 0 0; text-align: center;">
                    <a href="{{ appleWalletUrl }}" target="_blank" style="display: inline-block;">
                        <img
                            src="cid:apple-wallet"
                            width="200"
                            height="60"
                            alt="{{ 'Wallet_AppleAlt' | t }}"
                            border="0"
                            style="height: auto; max-width: 200px; display: block;"
                        >
                    </a>
                </td>
            </tr>
        </table>
    </td>
</tr>
<!-- WalletCTA : END -->
